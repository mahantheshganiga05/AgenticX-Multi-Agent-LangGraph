# LLM Provider Configuration
# Supported providers: "mock", "google", "openai"
LLM_PROVIDER=mock

# Model Name (optional, defaults based on provider)
# For Google Gemini: gemini-2.0-flash, gemini-1.5-pro, etc.
# For OpenAI: gpt-4o-mini, gpt-4o, etc.
MODEL_NAME=gemini-2.0-flash

# API Keys (leave empty or set LLM_PROVIDER=mock to run deterministically without external API)
# GOOGLE_API_KEY=your_google_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
